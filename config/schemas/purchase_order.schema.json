{
  "id": "purchase_order",
  "name": "Purchase Order Schema",
  "doc_type": "purchase_order",
  "description": "Purchase order extraction schema",
  "json_schema": {
    "type": "object",
    "properties": {
      "po_number": {"type": "string"},
      "po_date": {"type": "string"},
      "buyer_name": {"type": "string"},
      "buyer_address": {"type": "string"},
      "vendor_name": {"type": "string"},
      "vendor_address": {"type": "string"},
      "ship_to_name": {"type": "string"},
      "ship_to_address": {"type": "string"},
      "requested_delivery_date": {"type": "string"},
      "payment_terms": {"type": "string"},
      "line_items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "item_number": {"type": "string"},
            "description": {"type": "string"},
            "quantity": {"type": "number"},
            "unit_price": {"type": "number"},
            "amount": {"type": "number"}
          },
          "required": ["description", "quantity", "unit_price", "amount"]
        }
      },
      "subtotal": {"type": "number"},
      "tax_amount": {"type": "number"},
      "shipping_amount": {"type": "number"},
      "total": {"type": "number"}
    },
    "required": ["po_number", "po_date", "vendor_name", "line_items", "total"]
  }
}
